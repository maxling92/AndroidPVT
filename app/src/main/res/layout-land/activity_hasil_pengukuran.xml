<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.digitech_maker.pvt2025.HasilPengukuran">
    <RelativeLayout
        android:id="@+id/RelativeLayout01"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content" >

        <!-- Name Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hasil_namatext"
            android:id="@+id/namatext"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="false"
            android:layout_alignParentStart="true" />

        <!-- Name EditText -->
        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:text="@string/hasil_editnama"
            android:ems="10"
            android:id="@+id/editnama"
            android:autoText="true"
            android:clickable="true"
            android:editable="true"
            android:enabled="true"
            android:shadowColor="#b6abab"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:textSize="20dp" />

        <!-- Save Button -->
        <Button
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hasil_simpanbtn"
            android:id="@+id/simpanbutton"
            android:layout_alignBottom="@+id/editnama"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

        <!-- Date of Birth Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hasil_tgllahirtext"
            android:id="@+id/tgllahirtext"
            android:layout_below="@+id/editnama"
            android:gravity="bottom"
            android:layout_alignParentLeft="true"
            android:textSize="16dp" />

        <!-- Date of Birth EditText -->
        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:inputType="date"
            android:hint="dd-MM-yyyy"
            android:ems="10"
            android:id="@+id/edittgllahir"
            android:autoText="true"
            android:clickable="true"
            android:editable="true"
            android:enabled="true"
            android:shadowColor="#b6abab"
            android:layout_alignTop="@+id/tgllahirtext"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="100dp"
            android:textSize="16dp" />

        <!-- Submit Button -->
        <Button
            style="?android:attr/buttonStyleSmall"
            android:id="@+id/kirimbutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hasil_kirimbtn"
            android:layout_marginTop="16dp"
            android:layout_alignBottom="@id/edittgllahir"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

        <!-- Company Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hasil_perusahaantext"
            android:id="@+id/perusahaantext"
            android:layout_below="@+id/edittgllahir"
            android:textAlignment="gravity"
            android:layout_alignParentLeft="true"
            android:textSize="16dp" />

        <!-- Company EditText -->
        <EditText
            android:id="@+id/editperusahaan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/perusahaantext"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="100dp"
            android:layout_marginTop="2dp"
            android:autoText="true"
            android:clickable="true"
            android:editable="true"
            android:ems="20"
            android:enabled="true"
            android:inputType="textPersonName"
            android:shadowColor="#b6abab"
            android:text="@string/hasil_editperusahaan"
            android:textSize="16dp"
            android:layout_below="@+id/edittgllahir" />

        <!-- LinearLayout for labels and table -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_below="@+id/editperusahaan">

            <!-- Location Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hasil_lokasilabel"
                android:id="@+id/lokasilabel"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true" />

            <!-- Type Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hasil_tipelabel"
                android:id="@+id/tipelabel"
                android:layout_below="@+id/lokasilabel"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true" />

            <!-- Result Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hasil_hasillabel"
                android:id="@+id/hasillabel"
                android:layout_below="@+id/tipelabel"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true" />

            <!-- Failed Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hasil_gagallabel"
                android:id="@+id/gagallabel"
                android:layout_alignTop="@+id/hasillabel"
                android:layout_toRightOf="@+id/tipelabel"
                android:layout_toEndOf="@+id/tipelabel" />

            <!-- Table for Results -->
            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="176dp"
                android:id="@+id/tabelhasil"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_below="@+id/hasillabel"
                android:layout_weight="0.21">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="24dp">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/col1"
                        android:text="@string/hasil_tblcol1"
                        android:layout_column="0"
                        android:layout_gravity="center_horizontal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/col2"
                        android:text="@string/hasil_tblcol2"
                        android:layout_weight="1"
                        android:layout_column="1"
                        android:gravity="center_horizontal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/col3"
                        android:text="@string/hasil_tblcol1"
                        android:layout_column="3"
                        android:layout_gravity="center_horizontal"
                        android:layout_weight="1"
                        android:gravity="center_horizontal" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/col4"
                        android:text="@string/hasil_tblcol2"
                        android:layout_weight="1"
                        android:layout_column="4"
                        android:gravity="center_horizontal" />
                </TableRow>
            </TableLayout>

            <!-- Buttons -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Delete Button -->
                <Button
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="@string/hasil_hapusbtn"
                    android:id="@+id/hapusbutton"
                    android:layout_alignWithParentIfMissing="false"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true" />

                <!-- Next Button -->
                <Button
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=">>"
                    android:id="@+id/nextbutton"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
